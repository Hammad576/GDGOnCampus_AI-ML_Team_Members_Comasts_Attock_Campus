  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np\n\n# 1) Structured array: name(str), age(int), weight(float); sort by age\ndt = np.dtype([('name', 'U10'), ('age', 'i4'), ('weight', 'f4')])\npeople = np.array([('Alice', 25, 55.5), ('Bob', 20, 70.2),\n                   ('Cathy', 30, 50.0), ('Dave', 20, 65.0)], dtype=dt)\nprint(\"Original:\"); print(people)\nprint(\"Sorted by age:\"); print(np.sort(people, order='age'))\n\n# 2) Structured array: fields x, y (int); Euclidean distance between each pair\ndt2 = np.dtype([('x', 'i4'), ('y', 'i4')])\npts = np.array([(0, 0), (3, 4), (6, 8)], dtype=dt2)\nprint(\"Points:\"); print(pts)\nxs = pts['x']\nys = pts['y']\nd = np.sqrt((xs[:, None] - xs[None, :])**2 + (ys[:, None] - ys[None, :])**2)\nprint(\"Euclidean distance matrix (between each pair of points):\"); print(np.round(d, 3))\n"
   ],
