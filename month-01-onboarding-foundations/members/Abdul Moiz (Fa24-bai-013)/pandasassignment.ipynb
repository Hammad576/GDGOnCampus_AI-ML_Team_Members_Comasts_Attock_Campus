  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "1. Create a Pandas DataFrame with 4 columns and 6 rows filled with random integers. Set the index to be the first column.\n2. Create a Pandas DataFrame with columns 'A', 'B', 'C' and index 'X', 'Y', 'Z'. Fill the DataFrame with random integers and access the element at row 'Y' and column 'B'."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd\nimport numpy as np\n\n# 1) DataFrame 4 cols x 6 rows random ints; set index to the first column\nnp.random.seed(1101)\ndf = pd.DataFrame(np.random.randint(1, 51, size=(6, 4)), columns=['A', 'B', 'C', 'D'])\ndf = df.set_index(df.columns[0])\nprint(\"DataFrame with first column as index:\"); print(df)\n\n# 2) DataFrame cols A,B,C; index X,Y,Z; access element row 'Y', column 'B'\ndf2 = pd.DataFrame(np.random.randint(1, 51, size=(3, 3)),\n                   columns=['A', 'B', 'C'], index=['X', 'Y', 'Z'])\nprint(\"DataFrame:\"); print(df2)\nprint(\"Element at row 'Y' and column 'B':\", df2.loc['Y', 'B'])\n"
