    "## Assignment: Masked Arrays"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "1. Create a masked array of shape (4, 4) with random integers and mask the elements greater than 10. Compute the sum of the unmasked elements.\n2. Create a masked array of shape (3, 3) with random integers and mask the diagonal elements. Replace the masked elements with the mean of the unmasked elements."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np\nimport numpy.ma as ma\n\n# 1) (4,4) random; mask elements > 10; sum of unmasked\nnp.random.seed(910)\na = np.random.randint(1, 21, size=(4, 4))\nmasked = ma.masked_array(a, mask=(a > 10))\nprint(\"Masked array:\"); print(masked)\nprint(\"Sum of unmasked elements:\", masked.sum())\n\n# 2) (3,3) random; mask diagonal; replace masked elements with mean of unmasked\nnp.random.seed(911)\nb = np.random.randint(1, 21, size=(3, 3))\nmasked_b = ma.masked_array(b, mask=np.eye(3, dtype=bool))\nprint(\"Original 3x3:\"); print(b)\nprint(\"Masked (diagonal masked):\"); print(masked_b)\nmean_unmasked = masked_b.mean()\nprint(\"Mean of unmasked elements: %.2f\" % mean_unmasked)\nresult = ma.filled(masked_b, fill_value=mean_unmasked)\nprint(\"After replacing masked diagonal with the mean:\"); print(np.round(result, 2))\n"
   ],
   "execution_count": null,
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Masked array:\n",
      "[[-- -- -- --]\n",
      " [3 10 -- 3]\n",
      " [9 6 3 2]\n",
      " [1 9 -- 10]]\n",
      "Sum of unmasked elements: 56\n",
      "Original 3x3:\n",
      "[[12 19  9]\n",
      " [ 8 18  9]\n",
      " [ 5  4  8]]\n",
