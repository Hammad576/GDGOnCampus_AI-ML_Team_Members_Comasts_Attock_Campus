    "import numpy as np\n\n# 1) (3,3) matrix; determinant, inverse, eigenvalues\nnp.random.seed(606)\nm = np.random.randint(1, 10, size=(3, 3))\nprint(\"3x3 matrix:\"); print(m)\nprint(\"Determinant: %.4f\" % np.linalg.det(m))\nprint(\"Inverse:\"); print(np.round(np.linalg.inv(m), 4))\nprint(\"Eigenvalues:\"); print(np.linalg.eigvals(m))\n\n# 2) (2,3) and (3,2); matrix multiplication\nx = np.arange(1, 7).reshape(2, 3)\ny = np.arange(10, 16).reshape(3, 2)\nprint(\"2x3 matrix:\"); print(x)\nprint(\"3x2 matrix:\"); print(y)\nprint(\"Matrix product (x @ y):\"); print(x @ y)\n"
