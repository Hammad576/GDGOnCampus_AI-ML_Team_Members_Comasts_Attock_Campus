   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd\nimport numpy as np\n\n# 1) 3 cols x 5 rows random; apply a function that doubles the values\nnp.random.seed(1901)\ndf = pd.DataFrame(np.random.randint(1, 11, size=(5, 3)), columns=['A', 'B', 'C'])\nprint(\"Original DataFrame:\"); print(df)\nprint(\"Doubled values:\"); print(df.apply(lambda col: col * 2))\n\n# 2) 3 cols x 6 rows random; lambda to create a new column = sum of existing columns\nnp.random.seed(1902)\ndf = pd.DataFrame(np.random.randint(1, 11, size=(6, 3)), columns=['X', 'Y', 'Z'])\nprint(\"Original DataFrame:\"); print(df)\ndf['Total'] = df.apply(lambda row: row['X'] + row['Y'] + row['Z'], axis=1)\nprint(\"With new 'Total' column:\"); print(df)\n"
