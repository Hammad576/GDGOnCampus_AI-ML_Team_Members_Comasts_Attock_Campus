    "## Assignment: Pivot Tables"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "1. Create a Pandas DataFrame with columns 'Date', 'Category', and 'Value'. Create a pivot table to compute the sum of 'Value' for each 'Category' by 'Date'.\n2. Create a Pandas DataFrame with columns 'Year', 'Quarter', and 'Revenue'. Create a pivot table to compute the mean 'Revenue' for each 'Quarter' by 'Year'."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd\nimport numpy as np\n\n# 1) cols Date, Category, Value; pivot table sum of Value by Category by Date\nnp.random.seed(1801)\ndates = pd.date_range('2021-01-01', periods=12, freq='D')\ndf = pd.DataFrame({\n    'Date': dates,\n    'Category': np.random.choice(['A', 'B', 'C'], size=12),\n    'Value': np.random.randint(1, 21, size=12)\n})\nprint(\"DataFrame:\"); print(df)\npivot = df.pivot_table(values='Value', index='Date', columns='Category',\n                       aggfunc='sum', fill_value=0)\nprint(\"Pivot table (sum of Value by Category by Date):\"); print(pivot)\n\n# 2) cols Year, Quarter, Revenue; pivot table mean Revenue by Quarter by Year\nnp.random.seed(1802)\ndf = pd.DataFrame({\n    'Year': [2020, 2020, 2020, 2021, 2021, 2021, 2021],\n    'Quarter': [1, 2, 1, 2, 1, 3, 4],\n    'Revenue': np.random.randint(1000, 10001, size=7)\n})\nprint(\"DataFrame:\"); print(df)\npivot = df.pivot_table(values='Revenue', index='Year', columns='Quarter',\n                       aggfunc='mean', fill_value=0)\nprint(\"Pivot table (mean Revenue by Quarter by Year):\"); print(pivot)\n"
   ],
   "execution_count": null,
   "outputs": [
