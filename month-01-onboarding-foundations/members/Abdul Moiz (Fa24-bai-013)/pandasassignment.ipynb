    "## Assignment: Data Cleaning"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "1. Create a Pandas DataFrame with 3 columns and 5 rows filled with random integers. Introduce some NaN values. Fill the NaN values with the mean of the respective columns.\n2. Create a Pandas DataFrame with 4 columns and 6 rows filled with random integers. Introduce some NaN values. Drop the rows with any NaN values."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd\nimport numpy as np\n\n# 1) 3 cols x 5 rows random; introduce NaN; fill with column mean\nnp.random.seed(1301)\ndf = pd.DataFrame(np.random.randint(1, 11, size=(5, 3)), columns=['A', 'B', 'C'])\ndf.iloc[1, 1] = np.nan\ndf.iloc[3, 0] = np.nan\nprint(\"Original DataFrame:\"); print(df)\nprint(\"NaN filled with column means:\"); print(df.fillna(df.mean()))\n\n# 2) 4 cols x 6 rows random; introduce NaN; drop rows with any NaN\nnp.random.seed(1302)\ndf = pd.DataFrame(np.random.randint(1, 11, size=(6, 4)), columns=['A', 'B', 'C', 'D'])\ndf.iloc[2, 2] = np.nan\ndf.iloc[4, 3] = np.nan\nprint(\"Original DataFrame:\"); print(df)\nprint(\"After dropping rows with any NaN:\"); print(df.dropna())\n"
   ],
