  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np\n\n# 1) (3,3) values 1..9; reshape to (1,9) then (9,1)\na = np.arange(1, 10).reshape(3, 3)\nprint(\"Original 3x3:\"); print(a)\nprint(\"Reshaped (1, 9):\"); print(a.reshape(1, 9))\nprint(\"Reshaped (9, 1):\"); print(a.reshape(9, 1))\n\n# 2) (5,5) random; flatten then reshape back to (5,5)\nnp.random.seed(707)\nb = np.random.randint(1, 51, size=(5, 5))\nflat = b.flatten()\nrecovered = flat.reshape(5, 5)\nprint(\"Original 5x5:\"); print(b)\nprint(\"Flattened shape:\", flat.shape, \"| first 5:\", flat[:5].tolist())\nprint(\"Recovered 5x5:\"); print(recovered)\nprint(\"Original and recovered arrays are equal:\", np.array_equal(b, recovered))\n"
