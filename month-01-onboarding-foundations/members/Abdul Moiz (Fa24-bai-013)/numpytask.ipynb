   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np\n\n# 1) (5,5) random; fancy indexing to extract the four corners\nnp.random.seed(808)\na = np.random.randint(1, 51, size=(5, 5))\ncorners = a[(0, 0, -1, -1), (0, -1, 0, -1)]\nprint(\"5x5 array:\"); print(a)\nprint(\"Corner elements (top-left, top-right, bottom-left, bottom-right):\", corners.tolist())\n\n# 2) (4,4) random; boolean indexing: set all elements > 10 to 10\nnp.random.seed(809)\nb = np.random.randint(1, 21, size=(4, 4))\nprint(\"Original 4x4:\"); print(b)\nb[b > 10] = 10\nprint(\"After boolean indexing (values > 10 set to 10):\"); print(b)\n"
